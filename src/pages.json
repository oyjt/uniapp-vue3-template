{
  "easycom": {
    "custom": {
      "^u--(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^up-(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^u-([^-].*)": "uview-plus/components/u-$1/u-$1.vue",
      "^(?!z-paging-refresh|z-paging-load-more)z-paging(.*)": "z-paging/components/z-paging$1/z-paging$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/tab/home/index",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/tab/match/index",
      "style": {
        "navigationBarTitleText": "约球大厅"
      }
    },
    {
      "path": "pages/tab/record/index",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/tab/user/index",
      "style": {
        "navigationStyle": "custom"
      },
      "needLogin": true
    }
  ],
  "subPackages": [
    {
      "root": "pages/activity",
      "pages": [
        {
          "path": "create/index",
          "style": {
            "navigationBarTitleText": "发起约球"
          }
        },
        {
          "path": "detail/index",
          "style": {
            "navigationBarTitleText": "活动详情"
          }
        },
        {
          "path": "match-type/index",
          "style": {
            "navigationBarTitleText": "选择比赛类型"
          }
        },
        {
          "path": "create-match/index",
          "style": {
            "navigationBarTitleText": "发起比赛"
          }
        },
        {
          "path": "match-detail/index",
          "style": {
            "navigationStyle": "custom"
          }
        },
        {
          "path": "scoring/index",
          "style": {
            "navigationStyle": "custom"
          }
        }
      ]
    },
    {
      "root": "pages/common",
      "pages": [
        {
          "path": "login/index",
          "style": {
            "navigationBarTitleText": "登录",
            "navigationStyle": "custom"
          }
        },
        {
          "path": "webview/index",
          "style": {
            "navigationBarTitleText": "网页"
          }
        },
        {
          "path": "404/index",
          "style": {
            "navigationBarTitleText": "404",
            "navigationStyle": "custom"
          }
        },
        {
          "path": "theme/index",
          "style": {
            "navigationBarTitleText": "主题设置"
          }
        }
      ]
    }
  ],
  "preloadRule": {
    "pages/tab/home/index": {
      "network": "all",
      "packages": ["pages/common", "pages/activity"]
    }
  },
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#21d59d",
    "borderStyle": "black",
    "backgroundColor": "#ffffff",
    "list": [
      {
        "iconPath": "static/images/tabbar/home.png",
        "selectedIconPath": "static/images/tabbar/home_selected.png",
        "pagePath": "pages/tab/home/index",
        "text": "首页"
      },
      {
        "iconPath": "static/images/tabbar/match.png",
        "selectedIconPath": "static/images/tabbar/match_selected.png",
        "pagePath": "pages/tab/match/index",
        "text": "约球"
      },
      {
        "iconPath": "static/images/tabbar/record.png",
        "selectedIconPath": "static/images/tabbar/record_selected.png",
        "pagePath": "pages/tab/record/index",
        "text": "战绩"
      },
      {
        "iconPath": "static/images/tabbar/user.png",
        "selectedIconPath": "static/images/tabbar/user_selected.png",
        "pagePath": "pages/tab/user/index",
        "text": "我的"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "羽毛球助手",
    "navigationBarBackgroundColor": "#F8F8F8",
    "backgroundColor": "#F8F8F8"
  }
}
